generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url= env("DATABASE_URL")
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  answerText String
  isCorrect  Boolean  @default(false)
  orderIndex Int
  // For matching questions - stores the pair data
  matchPair  String?
  // For fill in the blanks - stores the blank position
  blankPosition Int?
  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Course {
  id             String           @id
  title          String
  description    String
  thumbnail      String?
  price          Float            @default(0)
  teacherId      String
  createdAt      DateTime         @default(now())
  approvalStatus String           @default("pending")
  category       String?
  duration       String?
  isFree         Boolean          @default(false)
  updatedAt      DateTime         @updatedAt
  User           User             @relation(fields: [teacherId], references: [id])
  CourseContent  CourseContent[]
  CourseProgress CourseProgress[]
  Enrollment     Enrollment[]
  Feedback       Feedback[]
  Module         Module[]
  Quiz           Quiz[]
  ModuleProgress ModuleProgress[]
  Payment        Payment[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  resources   String?
  orderIndex  Int
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ModuleProgress ModuleProgress[]
}

model CourseContent {
  id         String      @id
  title      String
  type       ContentType
  url        String
  courseId   String
  orderIndex Int
  Course     Course      @relation(fields: [courseId], references: [id])
}

model CourseProgress {
  id               String   @id
  studentId        String
  courseId         String
  completedLessons Int      @default(0)
  totalLessons     Int      @default(0)
  progressPercent  Float    @default(0)
  completedAt      DateTime?  // Timestamp when course was fully completed
  lastAccessedAt   DateTime @default(now())
  updatedAt        DateTime
  Course           Course   @relation(fields: [courseId], references: [id])
  User             User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

// Track per-student completion of each module
model ModuleProgress {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  moduleId   String
  completed  Boolean  @default(false)
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  User   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId, courseId])
}

model Enrollment {
  id            String   @id
  studentId     String
  courseId      String
  enrolledAt    DateTime @default(now())
  isPaid        Boolean  @default(false)    // true for free courses or paid students
  paymentId     String?  // Foreign key to Payment model
  payment       Payment? @relation(fields: [paymentId], references: [id])
  Course        Course   @relation(fields: [courseId], references: [id])
  User          User     @relation(fields: [studentId], references: [id])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  courseId  String?  // Course feedback (optional)
  teacherId String?  // Teacher feedback (optional)
  rating    Int      // 1-5 stars
  comment   String
  type      FeedbackType @default(COURSE) // COURSE or TEACHER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id           String      @id @default(cuid())
  quizId       String
  questionText String
  questionType QuestionType @default(MULTIPLE_CHOICE)
  points       Int         @default(1)
  orderIndex   Int
  // Additional data for complex question types
  questionData Json?       // Stores additional configuration like blanks positions, matching pairs etc
  explanation  String?     // Optional explanation for the answer
  Answer       Answer[]
  Quiz         Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Quiz {
  id             String           @id @default(cuid())
  title          String
  courseId       String
  createdAt      DateTime         @default(now())
  description    String?
  updatedAt      DateTime         @updatedAt
  timeLimit      Int?             // Time limit in minutes
  maxAttempts    Int              @default(3)
  passingScore   Float            @default(60.0) // Percentage
  isPublished    Boolean          @default(false)
  Question       Question[]
  Course         Course           @relation(fields: [courseId], references: [id])
  QuizSubmission QuizSubmission[]
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  answers     Json     // Stores student's answers with question IDs
  score       Float?   // Calculated score
  maxScore    Float?   // Maximum possible score
  percentage  Float?   // Score as percentage
  isPassed    Boolean  @default(false)
  attemptNumber Int    @default(1)
  timeSpent   Int?     // Time spent in seconds
  submittedAt DateTime @default(now())
  Quiz        Quiz     @relation(fields: [quizId], references: [id])
  User        User     @relation(fields: [studentId], references: [id])
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  password       String
  role           Role
  approvalStatus String           @default("pending")
  createdAt      DateTime         @default(now())
  emailVerified  DateTime?
  referralCode   String?          @unique
  referredBy     String?
  isVIP          Boolean          @default(false)  // VIP status for 100+ completed courses
  vipGrantedAt   DateTime?        // When VIP status was granted
  instituteId    String?          // Link to institute
  Institute      Institute?       @relation(fields: [instituteId], references: [id])
  Course         Course[]
  CourseProgress CourseProgress[]
  Enrollment     Enrollment[]
  Feedback       Feedback[]
  QuizSubmission QuizSubmission[]
  EmailVerification EmailVerification[]
  ModuleProgress ModuleProgress[]
  Payment        Payment[]
  UserAwards     UserAward[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, otp])
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  amount          Float
  currency        String   @default("INR")
  razorpayOrderId String   @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  status          PaymentStatus @default(PENDING)  // PENDING, SUCCESS, FAILED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  User            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Enrollment      Enrollment[]
}

model Award {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String   // SVG or emoji
  milestone   Int      // Number of courses to achieve this award
  color       String   @default("blue") // Color theme: blue, silver, gold, platinum
  createdAt   DateTime @default(now())
  
  UserAwards  UserAward[]
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  awardId   String
  achievedAt DateTime @default(now())
  
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Award     Award    @relation(fields: [awardId], references: [id], onDelete: Cascade)
  
  @@unique([userId, awardId])
  @@index([userId])
  @@index([awardId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum ContentType {
  VIDEO
  NOTE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCH_COLUMN
  FILL_IN_BLANKS
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum FeedbackType {
  COURSE
  TEACHER
}

model Institute {
  id              String   @id @default(cuid())
  name            String
  domain          String   @unique // e.g., "viit.ac.in"
  description     String?
  address         String?
  phone           String?
  email           String?
  website         String?
  logo            String?
  established     String?  // Year established
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  Users           User[]   // Students and teachers from this institute
  
  @@index([domain])
}
