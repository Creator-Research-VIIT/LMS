generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Answer {
  id         String   @id
  questionId String
  answerText String
  isCorrect  Boolean  @default(false)
  orderIndex Int
  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Course {
  id             String           @id
  title          String
  description    String
  thumbnail      String?
  price          Float            @default(0)
  teacherId      String
  createdAt      DateTime         @default(now())
  approvalStatus String           @default("pending")
  category       String?
  duration       String?
  isFree         Boolean          @default(false)
  updatedAt      DateTime         @updatedAt
  User           User             @relation(fields: [teacherId], references: [id])
  CourseContent  CourseContent[]
  CourseProgress CourseProgress[]
  Enrollment     Enrollment[]
  Feedback       Feedback[]
  Module         Module[]
  Quiz           Quiz[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String?
  resources   String?
  orderIndex  Int
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseContent {
  id         String      @id
  title      String
  type       ContentType
  url        String
  courseId   String
  orderIndex Int
  Course     Course      @relation(fields: [courseId], references: [id])
}

model CourseProgress {
  id               String   @id
  studentId        String
  courseId         String
  completedLessons Int      @default(0)
  totalLessons     Int      @default(0)
  progressPercent  Float    @default(0)
  lastAccessedAt   DateTime @default(now())
  updatedAt        DateTime
  Course           Course   @relation(fields: [courseId], references: [id])
  User             User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model Enrollment {
  id         String   @id
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  Course     Course   @relation(fields: [courseId], references: [id])
  User       User     @relation(fields: [studentId], references: [id])
}

model Feedback {
  id        String   @id
  userId    String
  courseId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  Course    Course   @relation(fields: [courseId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model Question {
  id           String   @id
  quizId       String
  questionText String
  questionType String   @default("multiple_choice")
  points       Int      @default(1)
  orderIndex   Int
  Answer       Answer[]
  Quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Quiz {
  id             String           @id
  title          String
  courseId       String
  createdAt      DateTime         @default(now())
  description    String?
  updatedAt      DateTime
  Question       Question[]
  Course         Course           @relation(fields: [courseId], references: [id])
  QuizSubmission QuizSubmission[]
}

model QuizSubmission {
  id          String   @id
  quizId      String
  studentId   String
  answers     Json
  score       Float?
  maxScore    Float?
  submittedAt DateTime @default(now())
  Quiz        Quiz     @relation(fields: [quizId], references: [id])
  User        User     @relation(fields: [studentId], references: [id])

  @@unique([quizId, studentId])
}

model User {
  id             String           @id
  name           String
  email          String           @unique
  password       String
  role           Role
  approvalStatus String           @default("pending")
  createdAt      DateTime         @default(now())
  emailVerified  DateTime?
  referralCode   String?          @unique
  referredBy     String?
  Course         Course[]
  CourseProgress CourseProgress[]
  Enrollment     Enrollment[]
  Feedback       Feedback[]
  QuizSubmission QuizSubmission[]
}

enum ContentType {
  VIDEO
  NOTE
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}
