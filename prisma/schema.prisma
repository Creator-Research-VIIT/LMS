generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          String          @id @default(uuid())
  title       String
  description String
  thumbnail   String
  price       Float
  teacherId   String
  createdAt   DateTime        @default(now())
  approvalStatus String        @default("pending")
  teacher     User            @relation("CourseTeacher", fields: [teacherId], references: [id])
  contents    CourseContent[]
  enrollments Enrollment[]
  feedbacks   Feedback[]
  progresses  CourseProgress[] @relation("CourseProgress")
  quizzes     Quiz[]
}

model CourseContent {
  id         String      @id @default(uuid())
  title      String
  type       ContentType
  url        String
  courseId   String
  orderIndex Int
  course     Course      @relation(fields: [courseId], references: [id])
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id])
  student    User     @relation(fields: [studentId], references: [id])
}

model Quiz {
  id          String           @id @default(uuid())
  title       String
  description String?
  type        QuizType
  courseId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id])
  questions   Question[]
  submissions QuizSubmission[]
}

model Question {
  id            String   @id @default(uuid())
  quizId        String
  questionText  String
  questionType  String   @default("multiple_choice") // multiple_choice, true_false, short_answer
  points        Int      @default(1)
  orderIndex    Int
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       Answer[]
}

model Answer {
  id         String  @id @default(uuid())
  questionId String
  answerText String
  isCorrect  Boolean @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id          String   @id @default(uuid())
  studentId   String
  quizId      String
  score       Float
  maxScore    Float
  answers     Json     // Store student answers as JSON
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  student     User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, quizId]) // One submission per student per quiz
}

model CourseProgress {
  id              String  @id @default(uuid())
  studentId       String
  courseId        String
  progressPercent Float   @default(0)
  completed       Boolean @default(false)
  lastAccessedAt  DateTime @default(now())
  course          Course  @relation("CourseProgress", fields: [courseId], references: [id])
  student         User    @relation("StudentProgress", fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model User {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  password          String
  role              Role
  approvalStatus    String              @default("pending")
  createdAt         DateTime            @default(now())
  emailVerified     DateTime?
  image             String?
  referralCode      String?             @unique
  referredBy        String?
  courses           Course[]            @relation("CourseTeacher")
  progresses        CourseProgress[]    @relation("StudentProgress")
  EmailVerification EmailVerification[]
  enrollments       Enrollment[]
  feedbacks         Feedback[]
  quizSubmissions   QuizSubmission[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, otp])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ContentType {
  VIDEO
  NOTE
}

enum QuizType {
  PRACTICE
  ASSIGNMENT
  MID_TERM
  FINAL_EXAM
  CHAPTER_TEST
  POP_QUIZ
  REVIEW
}
